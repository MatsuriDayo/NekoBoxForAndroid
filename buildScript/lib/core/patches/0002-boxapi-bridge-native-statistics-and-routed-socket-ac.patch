--- /dev/null
+++ b/boxapi/v2ray_server.go
@@ -0,0 +1,32 @@
+package boxapi
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+)
+
+type SbV2rayServer struct {
+	ss *SbStatsService
+}
+
+func NewSbV2rayServer(options option.V2RayStatsServiceOptions) *SbV2rayServer {
+	return &SbV2rayServer{
+		ss: NewSbStatsService(options),
+	}
+}
+
+func (s *SbV2rayServer) Start() error                            { return nil }
+func (s *SbV2rayServer) Close() error                            { return nil }
+func (s *SbV2rayServer) StatsService() adapter.ConnectionTracker { return s.ss }
+
+// NekoRay style API
+
+func (s *SbV2rayServer) QueryStats(name string) int64 {
+	value, err := s.ss.GetStats(context.TODO(), name, true)
+	if err == nil {
+		return value
+	}
+	return 0
+}
diff --git a/boxapi/v2ray_stats_service.go b/boxapi/v2ray_stats_service.go
new file mode 100644
index 000000000..a26b1aa05
--- /dev/null
+++ b/boxapi/v2ray_stats_service.go
@@ -0,0 +1,32 @@
+package boxapi
+
+import (
+	"context"
+
+	"github.com/sagernet/sing-box/experimental/v2rayapi"
+	"github.com/sagernet/sing-box/option"
+)
+
+// SbStatsService preserves the Neko query API while using sing-box accounting.
+type SbStatsService struct {
+	*v2rayapi.StatsService
+}
+
+func NewSbStatsService(options option.V2RayStatsServiceOptions) *SbStatsService {
+	stats := v2rayapi.NewStatsService(options)
+	if stats == nil {
+		return nil
+	}
+	return &SbStatsService{StatsService: stats}
+}
+
+func (s *SbStatsService) GetStats(ctx context.Context, name string, reset bool) (int64, error) {
+	response, err := s.StatsService.GetStats(ctx, &v2rayapi.GetStatsRequest{
+		Name:   name,
+		Reset_: reset,
+	})
+	if err != nil {
+		return 0, err
+	}
+	return response.GetStat().GetValue(), nil
+}
diff --git a/boxapi/v2ray_stats_service_test.go b/boxapi/v2ray_stats_service_test.go
