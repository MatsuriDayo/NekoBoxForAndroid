#!/bin/bash

EXEC=""
TARGET="buildScript"
PARAMS=()

for e in "$@"; do
  TARGET="$TARGET/$e"
  PARAMS+=("$e")
  if [ -x "${TARGET}.sh" ]; then
    EXEC="${TARGET}.sh"
    PARAMS=()
  fi
done

if [ -z "$EXEC" ]; then
  echo "Usage: $0 <build script> [arguments...]" >&2
  exit 2
fi
echo ">> $EXEC"
exec "$EXEC" "${PARAMS[@]}"
